# Normalise line endings in the repository to LF, regardless of the
# contributor's platform. Windows checkouts still get CRLF in the working
# tree for text files, so editors behave normally.
* text=auto eol=lf

# Windows-only scripts must keep CRLF so cmd.exe can parse them.
*.bat text eol=crlf
*.cmd text eol=crlf

# Shell scripts must stay LF or they break under Git Bash / Linux containers.
*.sh text eol=lf

# Binary assets — never touch these.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary

# Lockfiles are generated; keep them out of language stats and diffs noise.
package-lock.json -diff linguist-generated
