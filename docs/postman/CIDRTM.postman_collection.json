              "raw": "{{baseUrl}}/analytics/hourly?hours=24",
              "host": ["{{baseUrl}}"],
              "path": ["analytics", "hourly"],
              "query": [{ "key": "hours", "value": "24" }]
            }
          }
        },
        {
          "name": "Daily series",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/analytics/daily?days=7",
              "host": ["{{baseUrl}}"],
              "path": ["analytics", "daily"],
              "query": [{ "key": "days", "value": "7" }]
            }
          }
        },
        {
          "name": "Summary",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/analytics/summary", "host": ["{{baseUrl}}"], "path": ["analytics", "summary"] }
          }
        },
        {
          "name": "Zone performance",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/analytics/zones", "host": ["{{baseUrl}}"], "path": ["analytics", "zones"] }
