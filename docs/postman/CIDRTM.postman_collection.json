              "raw": "{{baseUrl}}/analytics/full?hours=24&days=7",
              "host": ["{{baseUrl}}"],
              "path": ["analytics", "full"],
              "query": [
                { "key": "hours", "value": "24" },
                { "key": "days", "value": "7" }
              ]
            },
            "description": "One request hydrates the whole Analytics page: trends, distributions, zone performance, top-risk fleet and system info."
          }
        },
        {
          "name": "Hourly series",
          "request": {
            "method": "GET",
