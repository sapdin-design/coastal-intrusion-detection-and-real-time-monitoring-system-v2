# ─────────────────────────────────────────────────────────────
#  CIDRTM — Backend environment configuration
#  Copy to `.env` and adjust. All values below have safe defaults,
#  so the server boots with an empty .env in simulation mode.
# ─────────────────────────────────────────────────────────────

# Server
PORT=4000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173

# Auth
JWT_SECRET=change-me-in-production-cidrtm-secret
JWT_EXPIRES_IN=12h
BCRYPT_ROUNDS=10
# Shared secret a future GNSS / Raspberry Pi node sends as `x-device-key`
DEVICE_API_KEY=cidrtm-device-key

# Persistence
# Leave MONGODB_URI EMPTY to run on the in-memory repository (zero-install demo mode).
# Set it to switch to MongoDB + Mongoose without touching any other code.
MONGODB_URI=
MONGODB_DB=cidrtm
# In-memory mode only: snapshot the store to server/data/store.json so restarts keep data
MEMORY_PERSIST=true

# Logging: error | warn | info | http | debug
LOG_LEVEL=info

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=2000

# Geofencing engine
GEOFENCE_APPROACH_BUFFER_M=500      # distance from polygon edge that counts as "approaching"
GEOFENCE_ALERT_COOLDOWN_MS=45000    # suppress duplicate alerts for the same vessel+zone
GEOFENCE_LOITER_TICKS=6             # consecutive slow updates before a SUSPICIOUS_MOVEMENT alert

# Vessel health
VESSEL_OFFLINE_AFTER_MS=45000       # no position update for this long => OFFLINE
TRACK_POINTS_PER_VESSEL=600         # rolling track history kept per vessel

# GPS simulator
SIM_TICK_MS=1000                    # base tick interval
SIM_SPEED_MULTIPLIER=1              # 1 | 2 | 5 | 10
SIM_AUTOSTART=false                 # start the simulation as soon as the server boots
